# Copy to backend/.env and fill in. Never commit the real file.

# Boson AI (Higgs Realtime)
BOSON_API_KEY=
# BOSON_BASE_URL=https://api.boson.ai
# BOSON_REALTIME_WS=wss://api.boson.ai/v1/realtime?model=higgs-realtime

# Sign-in: Firebase project whose Google sign-in the web app uses, and who may use the app
FIREBASE_PROJECT_ID=
VOICE_AGENT_ALLOWED_EMAILS=you@example.com

# Real phone calls (optional; browser calls work without Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VOICE_AGENT_FROM_NUMBER=+15555550100
# Only these numbers can ever be dialed (comma-separated E.164)
VOICE_AGENT_PHONE_ALLOW=+15555550101
# Public wss:// base of this server, reachable by Twilio
VOICE_AGENT_PUBLIC_WS_BASE=wss://your-host.example.com

# The demo patient who gets the real call (seed data)
VOICE_AGENT_DEMO_NAME=Jordan Lee
VOICE_AGENT_DEMO_PHONE=+15555550101
VOICE_AGENT_DEMO_EMAIL=demo@example.com

# Confirmation emails (optional)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# SQLite file (default: data/voice_agent.db at the repo root)
# VOICE_AGENT_DB=
